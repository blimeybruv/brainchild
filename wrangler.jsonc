// Cloudflare reads this when it builds the site from GitHub.
// "name" must match the site Worker, or the build fails.
// One Worker serves everything: api/worker.js answers /api/*, and site/ is served as static files.
{
  "name": "royal-firefly-b80b",
  "main": "./api/worker.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker script runs first for these paths; all other paths go straight to static files.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brainchild-db",
      "database_id": "6e241536-91de-49b7-b885-35429bd01efb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUILDS",
      "bucket_name": "brainchild-builds"
    }
  ],
  // Keeps the error logs the separate API Worker used to have.
  "observability": {
    "enabled": true
  },
  // Pull-request previews (built for every branch other than main) use their own test
  // database and bucket, so nothing tried out in a preview can touch the live data.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "brainchild-db-preview",
        "database_id": "3b6e6ea2-8a4a-469c-9150-4dcbad16ab64"
      }
    ],
    "r2_buckets": [
      {
        "binding": "BUILDS",
        "bucket_name": "brainchild-builds-preview"
      }
    ]
  }
}
