// The Worker that serves hosted game builds on brainwave.nexus (see worker.js).
// It has its own Cloudflare build, connected to this repo with this folder as its root, which
// redeploys it when a file here or api/build-rules.js changes on main.
// Never deploy this file from the site's own build: Cloudflare forces that build's Worker
// name, so this code would replace the website.
// Its routes (brainwave.nexus/* and *.brainwave.nexus/*) are set in Cloudflare, not here.
{
  "name": "brainchild-builds",
  "main": "./worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brainchild-db",
      "database_id": "6e241536-91de-49b7-b885-35429bd01efb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUILDS",
      "bucket_name": "brainchild-builds"
    }
  ],
  "observability": {
    "enabled": true
  }
}
